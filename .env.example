# Database configuration
# Use sqlite for local development: sqlite:///./sql_app.db
# Use postgresql for production: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./sql_app.db

# AI configuration
# Get your API key from https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# JWT Security (CHANGE THIS in production!)
JWT_SECRET=your-strong-random-secret-key

# Frontend URL for CORS (set to your deployed Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# Server port (Render auto-injects PORT)
PORT=8000
